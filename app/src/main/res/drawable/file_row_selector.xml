<?xml version="1.0" encoding="utf-8"?>
<!--
  The ListView selector. Cyan means "the remote is here" everywhere else on the
  console, so it means the same thing in the browser; a second accent colour
  would only make the caretaker learn the rule twice.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_cyan_dim" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_field_hot" />
                    <stroke android:width="1dp" android:color="@color/console_cyan" />
                </shape>
            </item>
            <item android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_cyan" />
                </shape>
            </item>
            <item android:left="4dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_field_hot" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
