<?xml version="1.0" encoding="utf-8"?>
<!--
  A row in a list — a theme, an announcement, a slide. Unfocused it is nearly
  invisible so the list reads as one column; focused it lifts and grows a cyan
  bar on its leading edge, the same spine the panels use. On a TV the focused
  row is the only row that matters, and it has to be findable from the back of
  the room.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_field_hot" />
                    <stroke android:width="1dp" android:color="@color/console_cyan" />
                </shape>
            </item>
            <item android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_cyan" />
                </shape>
            </item>
            <item android:left="4dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_field_hot" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_field" />
            <stroke android:width="1dp" android:color="@color/console_cyan_dim" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/console_field" />
            <stroke android:width="1dp" android:color="@color/console_line" />
        </shape>
    </item>

</selector>
