<?xml version="1.0" encoding="utf-8"?>
<!--
  Each section of the form sits on one of these: a slightly lifted slab with a
  cyan spine down its leading edge. The spine is what turns a long scrolling
  column into a stack of separate modules, so the caretaker can tell at a
  glance where "Waktu" ends and "Sistem" begins.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/console_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/console_line" />
        </shape>
    </item>

    <item android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_cyan_dim" />
        </shape>
    </item>

    <item
        android:left="3dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_panel" />
        </shape>
    </item>

</layer-list>
