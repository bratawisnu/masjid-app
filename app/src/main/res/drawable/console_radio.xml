<?xml version="1.0" encoding="utf-8"?>
<!--
  Square, not round: the platform's circle is the last stock shape left on
  these screens. Checked fills the box solid cyan — visible at a glance down a
  scrolling list of fifteen themes.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_cyan" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/console_void" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/console_line" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>

</selector>
