<?xml version="1.0" encoding="utf-8"?>
<!--
  A hard-edged track to match the brackets — the platform's rounded pill is the
  one shape on these screens that would still look like stock Android.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_cyan_dim" />
            <size android:height="20dp" android:width="52dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/console_field" />
            <stroke android:width="1dp" android:color="@color/console_line" />
            <size android:height="20dp" android:width="52dp" />
        </shape>
    </item>

</selector>
