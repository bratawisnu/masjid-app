<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical">

    <!--
      A single glyph carries folder-vs-file. On a screen read from three metres
      away with a remote in hand, that distinction has to survive at a glance,
      and it is the only thing the caretaker needs before pressing OK.
    -->
    <TextView
        android:id="@+id/text_marker"
        android:textColor="@color/console_cyan"
        android:textSize="20sp"
        android:layout_width="40dp"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/text_name"
        android:textColor="@color/console_text"
        android:textSize="18sp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content" />

    <!-- File size: a reading, so it lines up in monospace like the other data. -->
    <TextView
        android:id="@+id/text_meta"
        android:textColor="@color/console_text_muted"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
