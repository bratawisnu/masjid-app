<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/console_row"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!--
      One line per announcement or slide. The label can be long — a whole
      announcement, or a filename — so it is allowed two lines and then
      ellipsises, rather than pushing the switch and Hapus off the row.
    -->
    <TextView
        android:id="@+id/text_label"
        android:textColor="@color/console_text"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />

    <Switch
        android:id="@+id/switch_enabled"
        style="@style/ConsoleSwitch"
        android:layout_marginEnd="12dp" />

    <Button
        android:id="@+id/btn_delete"
        android:text="Hapus"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="13sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
