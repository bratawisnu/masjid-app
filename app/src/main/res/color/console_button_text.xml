<?xml version="1.0" encoding="utf-8"?>
<!-- Focus fills the button cyan, so the label has to flip dark to stay legible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/console_void" />
    <item android:state_pressed="true" android:color="@color/console_void" />
    <item android:state_enabled="false" android:color="@color/console_text_muted" />
    <item android:color="@color/console_text" />
</selector>
