<?xml version="1.0" encoding="utf-8"?>
<!--
  A locked field goes brass rather than grey. Grey reads as broken; brass says
  the value is settled and Reset is what reopens it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/console_brass" />
    <item android:color="@color/console_text" />
</selector>
